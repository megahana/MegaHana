# URL publique du site — source unique pour metadataBase, robots, sitemap, canoniques et Open Graph.
# En production (Vercel), remplacer par le domaine canonique définitif, ex : https://www.megamindstudio.com
NEXT_PUBLIC_SITE_URL=https://megamind-studio.vercel.app

# Clé d'accès publique Web3Forms (formulaire de contact, page Contact).
# Générée sur web3forms.com pour megahanapro@proton.me — publique par design
# (elle vit côté client dans le HTML du formulaire, ce n'est pas un secret
# d'API serveur), mais gérée en variable d'environnement pour rester
# modifiable sans toucher au code. À définir aussi dans les variables
# d'environnement Vercel au moment du déploiement.
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=
