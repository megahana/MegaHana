{
  "name": "megamind-studio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx,.cjs,.mjs",
    "lint:fix": "npm run lint -- --fix",
    "typecheck": "tsc --noEmit",
    "format:check": "prettier . --check",
    "format:write": "prettier . --write",
    "check": "npm run lint && npm run typecheck && npm run format:check",
    "check:release": "npm run check && npm run build"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "framer-motion": "^11.3.0",
    "lucide-react": "^0.400.0",
    "next": "^14.2.0",
    "next-intl": "^4.13.7",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "tailwind-merge": "^2.4.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.0",
    "eslint-config-next": "^14.2.0",
    "eslint-plugin-tailwindcss": "^3.18.3",
    "playwright": "^1.63.0",
    "postcss": "^8.4.39",
    "prettier": "^3.9.6",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.5.0"
  }
}
